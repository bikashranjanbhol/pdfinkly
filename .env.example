# Copy to apps/web/.env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string. Neon / Supabase / Vercel Postgres all work.
# Use the *pooled* URL in production (PgBouncer / Neon pooler).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pdfinkly

# Random secret for sessions and signed guest cookies: `openssl rand -base64 32`
AUTH_SECRET=

# Public URL of the app (no trailing slash). Used for share links and OAuth callbacks.
APP_URL=http://localhost:3000

# Protects /api/cron/cleanup. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────
# "local" stores PDFs on disk (dev only, not on Vercel). "s3" uses any S3-compatible bucket.
STORAGE_DRIVER=local
# Folder for the local driver (default: apps/web/.dev-storage)
# LOCAL_STORAGE_DIR=

# S3 / Cloudflare R2 / MinIO (only when STORAGE_DRIVER=s3)
# R2:    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
# MinIO: S3_ENDPOINT=http://localhost:9000  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pdfinkly
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Sign-in (optional; each provider appears only when both values are set) ──
# Google callback: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub callback: <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Shared rate limiting across serverless instances (falls back to in-memory per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max Postgres connections per server instance (default 5).
# DATABASE_POOL_MAX=5
